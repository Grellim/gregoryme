---
// FeelingList.astro — Horizontal list of experiences showing feeling_word + role + company
import { getCollection } from 'astro:content';

const experiences = await getCollection('experiences');
const sorted = experiences
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<section
  data-section="feeling"
  class="py-section bg-paper relative"
>
  <div class="grid-container">
    <!-- Section label -->
    <div class="col-span-full mb-8 md:mb-12">
      <span class="section-label">How I make people feel</span>
      <h2 class="font-display text-display-sm md:text-display text-ink mt-2">
        Experience in&nbsp;<span class="text-accent">one word</span>
      </h2>
    </div>
  </div>

  <!-- Feeling cards grid -->
  <div class="grid-container">
    {
      sorted.map((exp) => (
        <div
          data-feeling-item
          class="col-span-full sm:col-span-6 lg:col-span-4 group"
        >
          <div class="relative border border-ink/10 rounded-lg p-6 md:p-8 hover:border-accent/40 transition-colors duration-300 bg-paper">
            <!-- Feeling word — the DNA -->
            <p class="feeling-word text-accent text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-bold leading-none mb-4">
              {exp.data.feeling_word}
            </p>
            <!-- Role + Company -->
            <div class="mt-4 space-y-1">
              <p class="text-body text-ink/80 font-medium">
                {exp.data.role}
              </p>
              <p class="text-body-sm text-ink/40">
                {exp.data.company}{exp.data.location ? ` · ${exp.data.location}` : ''}
              </p>
            </div>
            <!-- Year range -->
            <p class="mt-3 text-feeling text-ink/25">
              {new Date(exp.data.start).getFullYear()} — {exp.data.current ? 'Present' : exp.data.end ? new Date(exp.data.end).getFullYear() : ''}
            </p>
            <!-- Summary -->
            <p class="mt-3 text-body-sm text-ink/50 leading-relaxed">
              {exp.data.summary}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

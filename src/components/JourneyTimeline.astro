---
// JourneyTimeline.astro — Vertical timeline of career milestones
import { getCollection } from 'astro:content';

const experiences = await getCollection('experiences');
const sorted = experiences
  .sort((a, b) => new Date(b.data.start).getTime() - new Date(a.data.start).getTime());
---

<section
  data-section="journey"
  class="py-section bg-paper relative"
>
  <div class="grid-container">
    <!-- Section label -->
    <div class="col-span-full mb-12 md:mb-16">
      <span class="section-label">The Journey</span>
      <h2 class="font-display text-display-sm md:text-display text-ink mt-2">
        From <span class="text-accent">cruise ships</span> to cafés
      </h2>
    </div>
  </div>

  <!-- Timeline -->
  <div class="relative max-w-3xl mx-auto px-4 sm:px-6">
    <!-- The line -->
    <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-ink/10 transform md:-translate-x-px">
      <div
        data-timeline-line
        class="w-full h-full bg-accent origin-top"
        style="transform: scaleY(0);"
      ></div>
    </div>

    <div class="space-y-12 md:space-y-16">
      {
        sorted.map((exp, i) => {
          const startYear = new Date(exp.data.start).getFullYear();
          const endLabel = exp.data.current ? 'Present' : exp.data.end ? new Date(exp.data.end).getFullYear() : '';
          const isEven = i % 2 === 0;

          return (
            <div
              data-timeline-item
              class={`relative pl-12 md:pl-0 ${
                isEven ? 'md:pr-[calc(50%+2rem)] md:text-right' : 'md:pl-[calc(50%+2rem)]'
              }`}
            >
              <!-- Dot on the line -->
              <div class={`absolute left-[10px] md:left-1/2 top-1 w-3 h-3 rounded-full bg-accent transform md:-translate-x-1.5 z-10 ring-4 ring-paper`}>
              </div>

              <div>
                <!-- Year -->
                <span class="text-feeling text-accent font-display font-medium">
                  {startYear} — {endLabel}
                </span>

                <!-- Feeling word emphasis -->
                <div class="mt-1 mb-2">
                  <span class="inline-block text-ink/20 text-3xl md:text-4xl font-display font-bold italic leading-none">
                    "{exp.data.feeling_word}"
                  </span>
                </div>

                <!-- Role + Company -->
                <h3 class="font-display text-xl md:text-2xl text-ink font-semibold">
                  {exp.data.role}
                </h3>
                <p class="text-body text-ink/40 mt-1">
                  {exp.data.company}{exp.data.location ? ` · ${exp.data.location}` : ''}
                </p>

                <!-- Story snippet -->
                <p class="mt-3 text-body text-ink/60 leading-relaxed max-w-md md:max-w-none">
                  {exp.data.summary}
                </p>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="min-h-screen bg-paper text-ink">
    <!-- Hero section placeholder — to be built in next task -->
    <section class="min-h-screen flex items-center justify-center px-4">
      <div class="text-center">
        <h1 class="font-display text-hero-sm md:text-hero lg:text-hero-lg font-bold text-ink leading-[0.9] tracking-tight">
          Gregory<br />Vallim
        </h1>
        <p class="mt-6 text-body-lg text-ink/60 max-w-xl mx-auto text-balance">
          Hospitality professional turned experience designer.
          7+ years making people feel taken care of.
        </p>
        <p class="mt-4 feeling-word">
          Coming soon
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
